# PriceDrop One Piece TCG — modello di configurazione
#
# Copia questo file in `.env` e compila i valori.
# Il file `.env` contiene segreti: non va mai versionato né condiviso.

# --- CardTrader -------------------------------------------------------------
# Token JWT della Full API. Si trova nella pagina impostazioni del tuo
# profilo CardTrader. Si incolla intero, senza la parola "Bearer" davanti
# e senza virgolette.
CARDTRADER_API_TOKEN=

# --- Notifiche Telegram -----------------------------------------------------
# Token del bot, ottenuto da @BotFather su Telegram.
TELEGRAM_BOT_TOKEN=
# Il tuo chat id personale, a cui il bot invierà gli alert.
TELEGRAM_CHAT_ID=

# --- Notifiche email --------------------------------------------------------
# Server SMTP del tuo provider. Per Gmail: smtp.gmail.com, porta 587.
SMTP_HOST=
SMTP_PORT=587
# L'indirizzo con cui ti autentichi al server.
SMTP_USER=
# ATTENZIONE, su Gmail non va la password dell'account: serve una "password
# per le app" di 16 caratteri, che Google rilascia solo se hai la verifica in
# due passaggi attiva (myaccount.google.com -> Sicurezza -> Password per le app).
SMTP_PASSWORD=
# Destinatario degli alert.
EMAIL_TO=
# Mittente, se diverso da SMTP_USER. Lascialo vuoto e userà SMTP_USER.
EMAIL_FROM=

# --- Applicazione -----------------------------------------------------------
# Percorso del database SQLite.
DATABASE_PATH=data/pricedrop.db
# Porta della dashboard locale.
WEB_PORT=8000
