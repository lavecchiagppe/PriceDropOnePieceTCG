# Segreti e configurazione locale
.env
.env.local
*.key
*.pem

# Database e dati raccolti.
# Su main il database non si versiona: la dashboard locale ci scrive, e un
# file versionato manderebbe in conflitto ogni git pull. La copia durevole
# dello storico vive sul branch "dati", che il workflow aggiorna una volta al
# giorno, e il PC si allinea con `python -m pricedrop sync`.
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor e sistema operativo
.vscode/
.idea/
Thumbs.db
desktop.ini
